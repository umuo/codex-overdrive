{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codex-monitor-app",
  "version": "0.1.5",
  "identifier": "com.gitsilence.codex-monitor-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Overdrive",
        "width": 1000,
        "height": 800,
        "minWidth": 800,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/umuo/codex-overdrive/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5Q0MwMjIwMDJCODJCMzQKUldRMEs3Z0NJQUxNYVgwdFFxUEFzazBuUVpPODJyWTFzWHhxWTBCMXQyZVZ0UUFXc0R5UWMxVFQK"
    }
  }
}
